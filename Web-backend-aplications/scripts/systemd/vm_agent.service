# Metrics control agent for the load-test harness (LAB USE ONLY - see loadtest/vm_agent.py).
# Set a token below and pass the same value to run_experiment.py --agent-token.
[Unit]
Description=Load-test metrics agent (port 9100)
After=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__REPO__
ExecStart=__REPO__/loadtest/.venv/bin/python __REPO__/loadtest/vm_agent.py --port 9100 --data-dir /home/__USER__/agent_runs --token CHANGE_ME
KillSignal=SIGTERM
Restart=on-failure

[Install]
WantedBy=multi-user.target
