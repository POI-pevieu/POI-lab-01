# Copie para .env e ajuste. O docker compose le este arquivo automaticamente.
DOCKERHUB_USER=seu-usuario-dockerhub
TAG=latest

# Portas das apps (a mesma porta no host e dentro do container)
COFRE_PORT=8124
GALERIA_PORT=8224
BOLSA_PORT=8324

# Workers por app (cofre: auto = um por vCPU)
COFRE_WORKERS=auto
GALERIA_WORKERS=1
BOLSA_WORKERS=4

# Cache da galeria: auto = fracao da RAM (ou do limite do container)
GALERIA_CACHE_MAX_MB=auto
GALERIA_CACHE_RAM_FRACTION=0.4
